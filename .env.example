# ===========================================================================
# TEFL.ai — environment variables
# Copy to .env.local for local dev. In production, set these in Vercel
# (Project Settings → Environment Variables). NEVER commit real values.
# ===========================================================================

# --- LLM provider (OpenRouter) ------------------------------------------------
# Server-only. Powers all 15 AI tools. Mirrors the current wp-config.php setup.
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL_SMALL=openai/gpt-4o-mini
LLM_MODEL_LARGE=openai/gpt-4o
LLM_MODEL_LESSON=google/gemini-3.5-flash-lite
LLM_MODEL_GRADER=google/gemini-3.5-flash-lite
LLM_AUDIO_MODE=openrouter_multimodal
LLM_AUDIO_OR_MODEL=google/gemini-3.5-flash
# Optional: sent to OpenRouter for usage dashboards / rankings
OPENROUTER_SITE_URL=https://tefl.ai
OPENROUTER_APP_NAME=TEFL.ai

# --- Google reCAPTCHA v3 ------------------------------------------------------
# Site key is public (exposed to browser); secret key is server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ENFORCE=true

# --- Headless WordPress (content: blog, pages, courses, certificates) --------
# WordPress stays as the backend API. Point at the live site (or a backend host).
WP_API_BASE=https://tefl.ai/wp-json
NEXT_PUBLIC_WP_MEDIA_BASE=https://tefl.ai/wp-content

# --- Commerce checkout hand-off ----------------------------------------------
# "Buy / Enrol" sends users to the WooCommerce checkout. Today that's tefl.ai;
# when WooCommerce moves to its own host, change this to https://shop.tefl.ai.
NEXT_PUBLIC_CHECKOUT_BASE_URL=https://tefl.ai

# --- MailerLite (footer newsletter) ------------------------------------------
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tefl.ai

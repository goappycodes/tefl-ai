    (function(){
      function animateCount(el){var target=parseFloat(el.getAttribute("data-count")||"0");if(!target||isNaN(target))return;var isDec=target%1!==0,dur=1600,start=performance.now();function step(now){var p=Math.min((now-start)/dur,1),eased=1-Math.pow(1-p,3),v=target*eased;el.textContent=isDec?v.toFixed(1):Math.floor(v).toLocaleString("en-IE");if(p<1)requestAnimationFrame(step);else el.textContent=isDec?target.toFixed(1):target.toLocaleString("en-IE")}requestAnimationFrame(step)}
      function initCount(){var els=document.querySelectorAll(".tai-stat-num[data-count]");if(!els.length)return;if(!("IntersectionObserver" in window)){els.forEach(animateCount);return}var seen=new WeakSet();var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting&&!seen.has(e.target)){seen.add(e.target);animateCount(e.target)}})},{threshold:.4});els.forEach(function(el){io.observe(el)})}
      var ROSTER=[{name:"Aoife from Cork",course:"Generative AI in TEFL Mastery",minutes:2},{name:"Daniel from Dublin",course:"120 Hour Advanced TEFL",minutes:4},{name:"Marta from Barcelona",course:"Travel Influencer TEFL",minutes:7},{name:"James from Manchester",course:"Generative AI in TEFL Mastery",minutes:9},{name:"Sophia from Boston",course:"120 Hour Advanced TEFL",minutes:12},{name:"Li Wei from Shanghai",course:"Travel Influencer TEFL",minutes:14},{name:"Michael from Toronto",course:"Generative AI in TEFL Mastery",minutes:18},{name:"Hannah from Sydney",course:"120 Hour Advanced TEFL",minutes:22},{name:"Ciarán from Galway",course:"Travel Influencer TEFL",minutes:26},{name:"Emma from Belfast",course:"120 Hour Advanced TEFL",minutes:31},{name:"Sean from Limerick",course:"Generative AI in TEFL Mastery",minutes:37},{name:"Olivia from Auckland",course:"Travel Influencer TEFL",minutes:43}];
      function makeToast(e){var d=document.createElement("div");d.className="tai-toast";d.setAttribute("role","status");d.setAttribute("aria-live","polite");d.innerHTML='<div class="tai-toast-body"><span class="tai-toast-name">'+e.name+'</span> just enrolled in <span class="tai-toast-course">'+e.course+'</span></div><div class="tai-toast-time">'+e.minutes+' min ago</div>';return d}
      function runFeed(){var path=window.location.pathname||"";if(/\/(cart|checkout|my-account)\//i.test(path))return;if(window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches)return;var i=Math.floor(Math.random()*ROSTER.length),cur=null;function next(){if(cur){cur.classList.remove("tai-toast-show");setTimeout(function(){if(cur&&cur.parentNode)cur.parentNode.removeChild(cur)},500)}var e=ROSTER[i%ROSTER.length];i++;cur=makeToast(e);document.body.appendChild(cur);cur.offsetHeight;cur.classList.add("tai-toast-show");setTimeout(function(){if(cur)cur.classList.remove("tai-toast-show")},6000)}setTimeout(function(){next();setInterval(next,180000)},90000)}
      if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",function(){initCount();runFeed()})}else{initCount();runFeed()}
    })();
    </script>
    	</body>
</html>

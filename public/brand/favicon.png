			<section id="media_image-3" class="widget widget_media_image"><a href="/"><img class="image footer-logo" src="https://tefl.ai/wp-content/uploads/2025/09/cropped-tefl-ai-logo-1.png" alt="" width="2997" height="678" decoding="async" loading="lazy" /></a></section><section id="block-11" class="widget widget_block"><div class="hire-wire-footer-signup" style="background-color:#0F3042;border:1px solid #64BE9F;border-radius:12px;padding:24px;color:#FFFFFF;max-width:520px;">
<div style="color:#64BE9F;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;">FREE TEFL JOBS BRIEFING</div>
<h3 style="color:#FFFFFF;margin:0 0 6px 0;font-size:24px;line-height:1.2;">The Hire Wire</h3>
<p style="color:#FFFFFF;margin:0 0 12px 0;font-size:14px;opacity:0.92;">Every TEFL opening, salary and deadline that matters.</p>
<form onsubmit="return hwTeflaiSub(this,event)" class="footer-form-container" style="margin:0;display:flex;gap:10px;flex-wrap:wrap;">
<div class="footer-form-group" style="margin:0;"><input type="email" name="email" required placeholder="Enter Your Email..." class="wpcf7-email footer-form-control" style="background:#FFFFFF;color:#0F3042;min-width:220px;padding:10px 14px;border-radius:6px;border:1px solid #64BE9F;"></div>
<div class="footer-form-group" style="margin:0;"><input type="submit" value="Get on the Wire" class="wpcf7-submit btn btn-primary btn-bordered footer-form-control" style="background-color:#64BE9F;border-color:#64BE9F;color:#0F3042;font-weight:700;cursor:pointer;"></div>
<div class="hw-form-msg" style="flex-basis:100%;color:#FFFFFF;font-weight:600;margin-top:6px;"></div>
</form>
<script>
function hwTeflaiSub(f,e){e.preventDefault();var b=f.querySelector('input[type=submit]'),m=f.querySelector('.hw-form-msg'),t=b.value;b.disabled=true;b.value='Sending...';var fd=new FormData();fd.append('fields[email]',f.email.value);fd.append('ml-submit','1');fd.append('anticsrf','true');fetch('https://assets.mailerlite.com/jsonp/995100/forms/194792070698763427/subscribe',{method:'POST',body:fd}).then(function(r){return r.json()}).then(function(d){if(d.success){f.email.style.display='none';b.style.display='none';m.textContent='You\'re on the Wire. The latest edition is on its way to your inbox.'}else{m.textContent='That email address did not work, please try again.';b.disabled=false;b.value=t}}).catch(function(){m.textContent='Something went wrong, please try again.';b.disabled=false;b.value=t});return false}
</script>
<div style="color:#FFFFFF;font-size:12px;opacity:0.7;margin-top:8px;">Free forever. Unsubscribe anytime.</div>
</div>
<style>
.hire-wire-footer-signup .footer-form-control.wpcf7-submit,
.hire-wire-footer-signup input.footer-form-control.btn { background-color:#64BE9F !important; border-color:#64BE9F !important; color:#0F3042 !important; }
.hire-wire-footer-signup input.wpcf7-email { background:#FFFFFF; color:#0F3042; }
</style></section><section id="custom_html-2" class="widget_text widget widget_custom_html"><div class="textwidget custom-html-widget"><style>
.tai-sg-form input[type=email]{color:#1c2b3a !important;background:#ffffff !important;caret-color:#1c2b3a !important;}
.tai-sg-form input[type=email]::placeholder{color:#7a8794 !important;opacity:1;}
</style>
<script id="tai-sg-hotfix">
(function () {
'use strict';
var orig = window.fetch;
if (!orig) { return; }
window.fetch = function (input, init) {
  try {
    var url = '';
    if (typeof input === 'string') { url = input; }
    else if (input) { url = input.url || ''; }
    if (url.indexOf('/tai/v1/softgate-unlock') !== -1) {
      if (init) { if (init.headers) {
        var h = init.headers;
        if (typeof h.delete === 'function') { h.delete('X-WP-Nonce'); }
        else {
          delete h['X-WP-Nonce'];
          delete h['x-wp-nonce'];
        }
      } }
    }
  } catch (e) {}
  return orig.apply(this, arguments);
};
var relabel = function () {
  var els = document.querySelectorAll('.tai-sg-error');
  for (var i = 0; i < els.length; i++) {
    var t = els[i].textContent || '';
    if (t.indexOf('That did not work') === 0) {
      if (t.indexOf('That did not work.') !== 0) { els[i].textContent = 'That did not work. Please check your email address and try again.'; }
    }
    if (t.indexOf('Network error') === 0) {
      if (t.indexOf('Network error.') !== 0) { els[i].textContent = 'Network error. Please try again.'; }
    }
  }
};
if (document.body) {
  var mo = new MutationObserver(relabel);
  mo.observe(document.body, { childList: true, subtree: true, characterData: true });
}
})();
</script></div></section>		</aside>

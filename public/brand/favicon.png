<style id="tai-keep-reading-grid-css">
        .tai-related-grid.tai-related-count-3,
        .tai-related-grid.tai-related-count-2 { display:grid; gap:24px; }
        .tai-related-grid.tai-related-count-3 { grid-template-columns:repeat(3, 1fr); }
        .tai-related-grid.tai-related-count-2 { grid-template-columns:repeat(2, 1fr); }
        @media (max-width: 900px) {
            .tai-related-grid.tai-related-count-3,
            .tai-related-grid.tai-related-count-2 { grid-template-columns:1fr; }
        }
        </style>    <style id="tai-busy-css">
    .tai-toast{position:fixed;bottom:24px;left:24px;z-index:9998;max-width:340px;padding:14px 18px;background:rgba(255,255,255,.98);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-radius:12px;border-left:4px solid #00c2a8;box-shadow:0 10px 40px rgba(0,0,0,.12);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;transform:translateY(120%);opacity:0;transition:transform .5s cubic-bezier(.34,1.56,.64,1),opacity .4s ease}
    .tai-toast.tai-toast-show{transform:translateY(0);opacity:1}
    .tai-toast-body{font-size:14px;color:#1a2332;line-height:1.4}
    .tai-toast-name{font-weight:600;color:#0a1929}
    .tai-toast-course{color:#00877a;font-weight:500}
    .tai-toast-time{font-size:12px;color:#7a8899;margin-top:4px}
    @media(max-width:640px){.tai-toast{left:12px;right:12px;max-width:none;bottom:12px}}
    .tai-course-social{display:flex;align-items:center;gap:14px;margin:12px 0 8px;font-size:13px;color:#4a5568;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
    .tai-rating{display:inline-flex;align-items:center;gap:4px}
    .tai-rating-stars{color:#f5b301;font-size:15px;letter-spacing:1px}
    .tai-rating-num{font-weight:600;color:#1a2332}
    .tai-rating-count{color:#7a8899}
    .tai-enrolled{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;background:#e6f7f4;color:#00877a;border-radius:12px;font-weight:600;font-size:12px}
    .tai-enrolled::before{content:"●";color:#00c2a8;font-size:8px;animation:tai-pulse 2s infinite}
    @keyframes tai-pulse{0%,100%{opacity:1}50%{opacity:.4}}
    .tai-trust-row{display:flex;justify-content:space-around;align-items:center;gap:12px;padding:18px 20px;margin:20px 0;background:linear-gradient(180deg,#f8fbfc 0%,#eef7f5 100%);border-radius:12px;border:1px solid #d8ebe6;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
    .tai-trust-item{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;color:#1a2332;font-size:12px;font-weight:500}
    .tai-trust-icon{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:#00c2a8;color:#fff;border-radius:50%;font-size:16px}
    @media(max-width:640px){.tai-trust-row{flex-direction:column;gap:14px}}
    #place_order,.woocommerce #place_order,.wc-block-components-checkout-place-order-button{position:relative!important;background:linear-gradient(135deg,#00c2a8 0%,#00e3c4 50%,#00c2a8 100%)!important;background-size:200% 200%!important;color:#fff!important;font-size:17px!important;font-weight:700!important;padding:16px 40px!important;border-radius:10px!important;border:none!important;letter-spacing:.5px!important;text-transform:uppercase!important;box-shadow:0 0 20px rgba(0,227,196,.6),0 8px 24px rgba(0,194,168,.4)!important;animation:tai-glow-pulse 2.4s ease-in-out infinite,tai-glow-shift 4s ease-in-out infinite!important;transition:transform .15s ease,box-shadow .3s ease!important}
    #place_order:hover,.woocommerce #place_order:hover,.wc-block-components-checkout-place-order-button:hover{transform:translateY(-2px)!important;box-shadow:0 0 30px rgba(0,227,196,.9),0 12px 32px rgba(0,194,168,.6)!important}
    @keyframes tai-glow-pulse{0%,100%{box-shadow:0 0 20px rgba(0,227,196,.6),0 8px 24px rgba(0,194,168,.4)}50%{box-shadow:0 0 32px rgba(0,227,196,.95),0 12px 32px rgba(0,194,168,.6)}}
    @keyframes tai-glow-shift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
    .ld-course-list-items .tai-course-card,.course-card{background:rgba(255,255,255,.85)!important;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(0,194,168,.15)!important;border-radius:14px!important;transition:transform .25s ease,box-shadow .25s ease!important}
    .ld-course-list-items .tai-course-card:hover,.course-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,194,168,.15)!important}
    .tai-accred-strip{padding:28px 20px 20px;background:rgba(255,255,255,.04);border-top:1px solid rgba(255,255,255,.08);text-align:center;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
    .tai-accred-label{display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:16px;font-weight:600}
    .tai-accred-logos{display:inline-flex;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap;padding:18px 28px;background:#fff;border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,.08)}
    .tai-accred-item{display:inline-flex;align-items:center;gap:12px;text-decoration:none;color:#1a2332;transition:opacity .2s ease}
    .tai-accred-item:hover{opacity:.75}
    .tai-accred-item img{height:44px;width:auto;display:block}
    .tai-accred-num{display:flex;flex-direction:column;text-align:left;line-height:1.25}
    .tai-accred-num strong{font-size:13px;font-weight:700;color:#0a1929}
    .tai-accred-num span{font-size:11px;color:#4a5568;letter-spacing:.5px}
    .tai-accred-divider{width:1px;height:40px;background:#d8ebe6}
    @media(max-width:640px){.tai-accred-logos{flex-direction:column;gap:18px;padding:20px}.tai-accred-divider{width:60%;height:1px}}
    </style>
    <style id="wp-custom-css">
.ld-focus-content h1 {
	display: none;
}

input.wpProQuiz_questionInput {
    margin-right: 5px !important;
}

.wpProQuiz_questionListItem {
    padding: 0 !important;
}

.wpProQuiz_maxtrixSortText {
    color: initial;
}

.wpProQuiz_sortStringItem.ui-sortable-handle {
    color: initial;
}


h2 {
	color: initial;
}

a.ld-button.ld-button-transparent {
    color: inherit;
}

#ld-breadcrumbs-lesson {
    color: initial;
}

span.ld-accordion__subheading.ld-accordion__subheading--quizzes {
    color: initial;
}

.ld-button {
    color: initial !important;
}

.ld-accordion__item-title--lesson {
    color: white !important;
}

.ld-accordion__item:hover {
    background-color: rgba(255, 255, 255, 0.1) !important;
}

.single-sfwd-lessons p {
    color: initial;
}

.single-sfwd-courses h2 {
    color: white;
}

.single-sfwd-courses .ld-layout__content {
	margin-top: 50px;	
}

.ld-progress-steps {
    color: initial;
}

.ld-accordion__item:has(.ld-accordion__expand-button[aria-expanded=true]) {
    background-color: rgba(255, 255, 255, 0.1) !important;
}


#post-1999 {
    margin-top: 6rem;
}

#ld-cvss-search-form {
    color: initial;
}

.ld-cvss-search-form-input {
    color: inherit !important;
}

.ld-certificate .wp-block-shortcode {
    color: #ffffff !important;
    font-size: 12px !important;
    letter-spacing: 1px;
    font-weight: 400;
    text-align: left; /* or center/right if you prefer */
}

/* Fix: transparent header covered content on tool pages without hero (added 2026-07-27) */
.page-id-2199 .site-content,
.page-id-2200 .site-content,
.page-id-2201 .site-content {
  padding-top: 110px;
}
@media (max-width: 921px) {
  .page-id-2199 .site-content,
  .page-id-2200 .site-content,
  .page-id-2201 .site-content {
    padding-top: 80px;
  }
}

/* Fix: theme h3 white band made headings invisible inside dark branded cards (added 2026-09-19) */
.tefl-survey-card h3,
.brand-video-frame h3 {
  background: none !important;
  background-color: transparent !important;
  color: #ffffff !important;
  padding: 0 !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* Fix: dark text on dark navy "The short version" cards in glossary posts (added 2026-09-28) */
div[style*="background: #0F2233" i] li,
div[style*="background:#0F2233" i] li {
  color: #e8f3f4 !important;
}
div[style*="background: #0F2233" i] li strong,
div[style*="background:#0F2233" i] li strong {
  color: #00e3c4 !important;
}
div[style*="background: #0F2233" i] li::marker,
div[style*="background:#0F2233" i] li::marker {
  color: #00e3c4;
}

</style>
</head>

